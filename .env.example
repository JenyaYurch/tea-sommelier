# Google AI Studio (week 1 prototype)
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=your-api-key-here

# Optional dev override for the agent model (default: gemini-3.6-flash).
# Useful when the free-tier daily quota is exhausted during eval iterations.
# TEA_AGENT_MODEL=gemini-3.1-flash-lite

# Telegram local polling (uv run python -m telegram_integration)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Vertex AI / Cloud Run (week 3)
# Project: TeaBot Project (billing already attached — do not start a new Free Trial).
# Secrets TELEGRAM_BOT_TOKEN and GOOGLE_API_KEY live in Secret Manager, not git.
#   uv run python scripts/setup_secret_manager.py
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=gen-lang-client-0393777014
# GOOGLE_CLOUD_LOCATION=global
# Cloud Run region: europe-central2
# GOOGLE_API_KEY is the Secret Manager name; local playground still uses GEMINI_API_KEY.
