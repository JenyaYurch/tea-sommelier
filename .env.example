# Google AI Studio (week 1 prototype)
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=your-api-key-here

# Optional dev override for the agent model (default: gemini-3.6-flash).
# Useful when the free-tier daily quota is exhausted during eval iterations.
# TEA_AGENT_MODEL=gemini-3.1-flash-lite

# Telegram local polling (uv run python -m telegram_integration)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Vertex AI / Cloud Run (week 3)
# Project: TeaBot Project (billing already attached — do not start a new Free Trial).
# Secrets TELEGRAM_BOT_TOKEN and GOOGLE_API_KEY live in Secret Manager, not git.
#   uv run python scripts/setup_secret_manager.py
# Two Cloud Run services (dry-run, then --execute after explicit approval):
#   uv run python scripts/deploy_cloud_run.py
#   uv run python scripts/deploy_cloud_run.py --execute
# Webhook: <telegram-integration-url>/<TELEGRAM_BOT_TOKEN>
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=gen-lang-client-0393777014
# GOOGLE_CLOUD_LOCATION=global
# Cloud Run region: europe-central2
# GOOGLE_API_KEY is the Secret Manager name; local playground still uses GEMINI_API_KEY.
# ADK_SERVER_URL=https://tea-agent-xxxx.run.app
# ADK_APP_NAME=tea_agent
# SERVICE_URL=https://telegram-integration-xxxx.run.app

# TEA-14 persistent sessions. Cloud Run disk is ephemeral.
#   uv run python scripts/setup_cloud_sql.py
#   uv run python scripts/setup_cloud_sql.py --execute
# Local polling defaults to sqlite (gitignored sessions.db) if unset:
# SESSION_SERVICE_URI=sqlite+aiosqlite:///./sessions.db
# Production: Cloud SQL (password is Secret Manager SESSION_DB_PASSWORD, not git)
# or Agent Engine sessions via GOOGLE_CLOUD_AGENT_ENGINE_ID below.
# CLOUD_SQL_INSTANCE=gen-lang-client-0393777014:europe-central2:tea-sessions
# SESSION_DB_USER=tea_agent
# SESSION_DB_NAME=tea_sessions
# Cloud Run unix socket dir (default /cloudsql from --add-cloudsql-instances):
# CLOUD_SQL_SOCKET_DIR=/cloudsql

# TEA-9 Memory Bank (opt-in, Agent Platform). Local/dev uses in-memory recall.
# europe-central2 has no Memory Bank; use the EU multi-region.
#   uv run python scripts/setup_memory_bank.py
#   uv run python scripts/setup_memory_bank.py --execute
# GOOGLE_CLOUD_AGENT_ENGINE_ID=
# GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=eu
# MEMORY_SERVICE_URI=agentengine://projects/PROJECT/locations/eu/reasoningEngines/ID
